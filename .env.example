# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Brevo Transactional Email Configuration
BREVO_API_KEY="your_brevo_api_key_here"
BREVO_SENDER_EMAIL="officialtraveloboom@gmail.com"
BREVO_REPLY_EMAIL="officialtraveloboom@gmail.com"
BREVO_SMTP_USER="smtp_user@smtp-brevo.com"

# AI Verification Keys
NVIDIA_API_KEY="your_nvidia_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# Neon Auth Configuration
NEON_AUTH_URL="https://your-app.neonauth.aws.neon.tech/neondb/auth"
NEON_JWKS_URL="https://your-app.neonauth.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Object Storage Configuration
AWS_REGION="us-east-2"
AWS_BUCKET="assets"
