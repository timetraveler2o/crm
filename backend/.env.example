# =========================================================================
# Get Set Flight CRM - Production Environment Configuration for Hostinger
# Add these keys in Hostinger hPanel -> Web Apps -> Environment Variables
# =========================================================================

# Database Configuration (Hostinger MySQL)
# On Hostinger Server, DB_HOST is 127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

PORT=3000

# Brevo (Sendinblue) Transactional Email & 2FA OTP Settings
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=officialtraveloboom@gmail.com
BREVO_REPLY_EMAIL=officialtraveloboom@gmail.com
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=bd8af4001@smtp-brevo.com
BREVO_SMTP_PASS=your_brevo_smtp_pass
BREVO_CC_EMAILS=officialtraveloboom@gmail.com,info@getsetflight.com

# AI KYC & Document Verification Keys
NVIDIA_API_KEY=your_nvidia_api_key
GEMINI_API_KEY=your_gemini_api_key
